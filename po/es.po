#: src/include/error.h:45
msgid "Wrong command"
msgstr "Comando incorrecto"

#: src/include/error.h:46
msgid "Empty command"
msgstr "Comando vacío"

#: src/include/error.h:47
msgid "Wrong amount of arguments on the command"
msgstr "Número incorrecto de argumentos en el comando"

#: src/include/error.h:48
msgid "Wrong arguments on the command"
msgstr "Argumentos incorrectos en el comando"

#: src/include/error.h:49
msgid "Command with subcommands empty"
msgstr "Comando con subcomandos vacío"

#: src/include/error.h:50
msgid "Error on execution of command"
msgstr "Error al ejecutar el comando"

#: src/include/error.h:51
msgid "File does not exist"
msgstr "El fichero no existe"

#: src/include/error.h:52
msgid "File is not a file"
msgstr "La ruta no es un fichero regular"

#: src/include/error.h:53
msgid "No window created"
msgstr "No se ha creado ninguna ventana"

#: src/include/error.h:54
msgid "No trace open on the focused panel"
msgstr "No hay ninguna traza abierta en el panel activo"

#: src/include/error.h:55
msgid "No result on the search"
msgstr "La búsqueda no ha dado resultados"

#: src/include/error.h:56
msgid "Index is bigger than array"
msgstr "El índice supera el tamaño del vector"

#: src/main.c:32
#, c-format
msgid "Usage: %s [OPTION]... [FILE]...\n"
msgstr "Uso: %s [OPCIÓN]... [FICHERO]...\n"

#: src/main.c:33
msgid "Open one or more instruction traces in an interactive TUI.\n"
msgstr "Abre una o más trazas de instrucciones en una TUI interactiva.\n"

#: src/main.c:35
msgid ""
"  -h, --help     display this help and exit\n"
"  -v, --version  display version information and exit\n"
msgstr ""
"  -h, --help     muestra esta ayuda y sale\n"
"  -v, --version  muestra la información de la versión y sale\n"

#: src/window.c:266
#, c-format
msgid "Lane %lu"
msgstr "Carril %lu"

#: src/window.c:551
#, c-format
msgid "Timeline %lu at cycle %lu"
msgstr "Línea temporal %lu, ciclo %lu"

#. TRANSLATORS: name of the mode shown in the status bar.
#: src/window.c:627
msgid "NORMAL"
msgstr "NORMAL"

#. TRANSLATORS: name of the mode shown in the status bar.
#: src/window.c:631
msgid "COMMAND"
msgstr "COMANDO"

#: src/window.c:646
#, c-format
msgid "Empty rows: %s"
msgstr "Filas vacías: %s"

#: src/window.c:647
msgid "on"
msgstr "sí"

#: src/window.c:647
msgid "off"
msgstr "no"
