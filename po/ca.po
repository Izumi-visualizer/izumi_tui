#: src/include/error.h:45
msgid "Wrong command"
msgstr "Ordre incorrecta"

#: src/include/error.h:46
msgid "Empty command"
msgstr "Ordre buida"

#: src/include/error.h:47
msgid "Wrong amount of arguments on the command"
msgstr "Nombre incorrecte d'arguments a l'ordre"

#: src/include/error.h:48
msgid "Wrong arguments on the command"
msgstr "Arguments incorrectes a l'ordre"

#: src/include/error.h:49
msgid "Command with subcommands empty"
msgstr "Ordre amb subordres buida"

#: src/include/error.h:50
msgid "Error on execution of command"
msgstr "Error en executar l'ordre"

#: src/include/error.h:51
msgid "File does not exist"
msgstr "El fitxer no existeix"

#: src/include/error.h:52
msgid "File is not a file"
msgstr "El camí no és un fitxer normal"

#: src/include/error.h:53
msgid "No window created"
msgstr "No s'ha creat cap finestra"

#: src/include/error.h:54
msgid "No trace open on the focused panel"
msgstr "No hi ha cap traça oberta al panell actiu"

#: src/include/error.h:55
msgid "No result on the search"
msgstr "La cerca no ha donat resultats"

#: src/include/error.h:56
msgid "Index is bigger than array"
msgstr "L'índex supera la mida del vector"

#: src/main.c:32
#, c-format
msgid "Usage: %s [OPTION]... [FILE]...\n"
msgstr "Ús: %s [OPCIÓ]... [FITXER]...\n"

#: src/main.c:33
msgid "Open one or more instruction traces in an interactive TUI.\n"
msgstr "Obre una o més traces d'instruccions en una TUI interactiva.\n"

#: src/main.c:35
msgid ""
"  -h, --help     display this help and exit\n"
"  -v, --version  display version information and exit\n"
msgstr ""
"  -h, --help     mostra aquesta ajuda i surt\n"
"  -v, --version  mostra la informació de la versió i surt\n"

#: src/window.c:266
#, c-format
msgid "Lane %lu"
msgstr "Carril %lu"

#: src/window.c:551
#, c-format
msgid "Timeline %lu at cycle %lu"
msgstr "Línia temporal %lu, cicle %lu"

